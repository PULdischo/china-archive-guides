# Copy to .env (git-ignored) and fill in.
DASHSCOPE_API_KEY=
# International (Singapore) endpoint; use https://dashscope.aliyuncs.com/compatible-mode/v1 for Beijing,
# or your workspace-specific endpoint. Keys are region-specific.
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3-vl-plus
# OCR engine whose output `cah export` uses: dashscope | rapidocr
CAH_OCR_ENGINE=dashscope

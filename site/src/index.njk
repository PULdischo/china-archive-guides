---
layout: layout.njk
---
<section class="hero">
  <h1>Find Chinese archives and local history sources</h1>
  <p>Search the tables of contents and fonds lists of Chinese archival handbooks (档案馆指南) together with
    wenshi ziliao (文史资料) indexes from Princeton's East Asian Library. Every result links back to the original scan.</p>
  <form action="/search/" method="get" class="searchbox" role="search">
    <label for="q" class="visually-hidden">Search</label>
    <input id="q" name="q" type="search" placeholder="e.g. 邮政, 煤矿, 交通部, 1949" lang="zh">
    <button type="submit">Search</button>
  </form>
</section>

<section class="browse-place" aria-labelledby="browse-place-h">
  <h2 id="browse-place-h">Browse by place</h2>
  <div class="place-grid">
    <figure class="province-map">
      <svg viewBox="{{ provinces.viewBox }}" role="group" aria-labelledby="pm-title">
        <title id="pm-title">Provinces with archive guides, shaded by number of guides</title>
        {% for p in provinces.provinces %}{% if p.d %}{% if p.count %}
        <a href="/search/?Province={{ p.zh | urlencode }}" class="prov c{{ p.cls }}" aria-label="{{ p.zh }} {{ p.en }}: {{ p.count }} guides">
          <title>{{ p.zh }} {{ p.en }}: {{ p.count }} guide{% if p.count != 1 %}s{% endif %}</title>
          <path d="{{ p.d }}"/>
        </a>
        {% else %}
        <g class="prov none"><title>{{ p.zh }} {{ p.en }}: no guides in the collection yet</title><path d="{{ p.d }}"/></g>
        {% endif %}{% endif %}{% endfor %}
      </svg>
      <div class="legend" aria-hidden="true">
        <span>Guides</span>
        {% set lo = 1 %}{% for b in provinces.breaks %}<span class="key"><span class="swatch c{{ loop.index0 }}"></span>{{ lo }}–{{ b }}</span>{% set lo = b + 1 %}{% endfor %}
        <span class="key"><span class="swatch c{{ provinces.breaks.length }}"></span>{{ lo }}+</span>
        <span class="key"><span class="swatch none"></span>None yet</span>
      </div>
      <figcaption>All provincial-level units are shown; gray ones have no guides in the collection yet.
        {{ provinces.source }}.</figcaption>
    </figure>
    <div class="province-list-wrap">
      <ol class="province-list">
        {% for p in provinces.provinces %}{% if p.count %}
        <li><a href="/search/?Province={{ p.zh | urlencode }}"><span lang="zh">{{ p.zh }}</span> <span class="en">{{ p.en }}</span></a><span class="n">{{ p.count }}</span></li>
        {% endif %}{% endfor %}
      </ol>
      <p><a href="/map/">Open the full map (prefectures and counties) →</a></p>
    </div>
  </div>
</section>

{% set handbooks = guides | whereEq("kind", "handbook") %}
{% set wenshi = guides | whereEq("kind", "wenshi") %}
<ul class="stats">
  <li><strong>{{ handbooks | length }}</strong> archival handbooks</li>
  <li><strong>{{ wenshi | length }}</strong> wenshi ziliao indexes</li>
  <li><strong>{{ guides | countOf("fonds") }}</strong> fonds extracted</li>
  <li><strong>{{ guides | countOf("toc") }}</strong> contents entries extracted</li>
  <li><strong>{{ guides | countOf("articles") }}</strong> wenshi articles extracted</li>
</ul>
<p class="note">Wenshi ziliao indexes are so far a sample of a few pages each; all archival handbooks are included.</p>

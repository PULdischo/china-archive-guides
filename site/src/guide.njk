---
layout: layout.njk
pagefind: true
pagination:
  data: guides
  size: 1
  alias: g
permalink: "/guides/{{ g.id }}/"
eleventyComputed:
  title: "{{ g.title_zh }}"
---
<p class="kind">{{ site.kindLabels[g.kind] }}</p>
<h1 lang="zh">{{ g.title_zh }}</h1>
{% if g.title_romanized %}<p class="romanized">{{ g.title_romanized }}</p>{% endif %}

<div class="links-back">
  <a class="button" href="{{ g.urls.dpul }}">View original in DPUL</a>
  {% if g.urls.catalog %}<a href="{{ g.urls.catalog }}">Catalog record</a>{% endif %}
  {% if g.urls.ark %}<a href="{{ g.urls.ark }}">ARK</a>{% endif %}
  <a href="{{ g.urls.manifest }}">IIIF manifest</a>
</div>

<dl class="meta">
  <dt>Editor</dt><dd lang="zh">{{ g.editor | join("; ") }}</dd>
  <dt>Publisher</dt><dd>{{ g.publisher | join("; ") }}</dd>
  <dt>Date</dt><dd>{{ g.year or "—" }}{% if g.date_malformed %} <span class="flag" title="Catalog date: {{ g.date_raw }}">catalog date “{{ g.date_raw }}” normalized</span>{% endif %}</dd>
  <dt>Place</dt><dd lang="zh">
    {% for p in g.places %}<a href="/map/#{{ p.id }}">{{ p.name_zh }}</a> ({{ site.levelLabels[p.level] }}){% if not loop.last %}, {% endif %}{% else %}—{% endfor %}
    {% if g.place_match %}<small>matched by {{ g.place_match | replace("_", " ") }}</small>{% endif %}
  </dd>
  {% if g.admin_code %}<dt>Admin code</dt><dd>{{ g.admin_code }}</dd>{% endif %}
  {% if g.archive_code %}<dt>Archive code</dt><dd>{{ g.archive_code }}</dd>{% endif %}
  <dt>Call number</dt><dd>{{ g.call_number }}</dd>
  <dt>Extent</dt><dd>{{ g.extent }}</dd>
  <dt>Rights</dt><dd>{{ g.rights }}</dd>
  {% if g.fonds_span %}<dt>Fonds cover</dt><dd>{{ g.fonds_span[0] }}–{{ g.fonds_span[1] }} (from extracted rows)</dd>{% endif %}
</dl>

{% if g.kind == "wenshi" %}
<h2>Locality volumes</h2>
<p class="note">This index is published in {{ g.volumes_total }} volumes, one per locality.{% if g.volumes_sampled %}
  Transcribed so far: {{ g.volumes.length }} (a sample).{% endif %}{% if g.volumes_restricted.length %}
  Restricted in DPUL: {% for r in g.volumes_restricted %}<span lang="zh">{{ r.label }}</span>{% if not loop.last %}, {% endif %}{% endfor %}.{% endif %}</p>
<table class="data">
  <thead><tr><th>Volume</th><th>Place</th><th>Scans</th><th>Articles</th></tr></thead>
  <tbody>{% for v in g.volumes %}
    <tr><td lang="zh"><a href="/wenshi/{{ v.id }}/">{{ v.label }}</a></td>
      <td lang="zh">{% if v.place %}<a href="/map/#{{ v.place.id }}">{{ v.place.name_zh }}</a>{% else %}—{% endif %}</td>
      <td>{{ v.pages.length }}{% if v.pages.length < v.canvas_count %} of {{ v.canvas_count }}{% endif %}</td>
      <td>{{ g.articles | whereEq("volume_id", v.id) | length }}</td></tr>
  {% endfor %}</tbody>
</table>
{% else %}
{% if g.volumes_sampled %}
<p class="note">Sampled: showing {{ g | pageCount }} pages. The full item is in DPUL.</p>
{% endif %}
{% if g.fonds.length %}
<details class="extracted">
  <summary>Fonds list — {{ g.fonds.length }} rows (machine-extracted, provisional)</summary>
  <table class="data">
    <thead><tr><th>No.</th><th>Fonds</th><th>Counts</th><th>Dates</th><th>Scan</th><th>DPUL</th></tr></thead>
    <tbody>{% for f in g.fonds %}
      <tr><td>{{ f.fonds_no }}</td><td lang="zh">{{ f.name }}</td><td>{{ f.counts | join(" / ") }}</td><td>{{ f.date_start }}–{{ f.date_end }}</td><td><a href="#p{{ f.page_n }}">p{{ f.page_n }}</a></td><td><a href="{{ f.viewer_url }}">View</a></td></tr>
    {% endfor %}</tbody>
  </table>
</details>
{% endif %}

{% if g.toc.length %}
<details class="extracted">
  <summary>Contents — {{ g.toc.length }} entries (machine-extracted, provisional)</summary>
  <table class="data">
    <thead><tr><th>Section</th><th>Entry</th><th>Book p.</th><th>Scan</th><th>DPUL</th></tr></thead>
    <tbody>{% for t in g.toc %}
      <tr><td lang="zh">{{ t.section }}</td><td lang="zh">{{ t.heading }}</td><td>{{ t.page }}</td><td><a href="#p{{ t.page_n }}">p{{ t.page_n }}</a></td><td><a href="{{ t.viewer_url }}">View</a></td></tr>
    {% endfor %}</tbody>
  </table>
</details>
{% endif %}

<h2>Pages</h2>
{% set title = g.title_zh %}
{% for v in g.volumes %}{% for p in v.pages %}
  {% include "page-section.njk" %}
{% endfor %}{% endfor %}
{% endif %}

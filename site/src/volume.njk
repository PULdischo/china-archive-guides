---
layout: layout.njk
pagination:
  data: wenshiVolumes
  size: 1
  alias: v
permalink: "/wenshi/{{ v.id }}/"
eleventyComputed:
  title: "{{ v.label }} · {{ v.item.short }}"
---
<p class="kind">{{ site.kindLabels.wenshi }} · <a href="/guides/{{ v.item.id }}/" lang="zh">{{ v.item.title }}</a></p>
<h1 lang="zh">{{ v.label }}</h1>

<div class="links-back">
  <a class="button" href="{{ v.item.urls.dpul }}">View original in DPUL</a>
  <a href="{{ v.pages[0].viewer_url if v.pages.length else v.item.urls.dpul }}">This volume in the viewer</a>
  <a href="{{ v.manifest }}">IIIF manifest</a>
</div>

<dl class="meta">
  <dt>Index</dt><dd lang="zh"><a href="/guides/{{ v.item.id }}/">{{ v.item.title }}</a> ({{ v.item.year }})</dd>
  <dt>Province</dt><dd lang="zh">{% if v.item.province %}<a href="{{ v.item.province.zh | browse("Province") }}">{{ v.item.province.zh }}</a>{% else %}—{% endif %}</dd>
  <dt>Place</dt><dd lang="zh">{% if v.place %}<a href="/map/#{{ v.place.id }}">{{ v.place.name_zh }}</a>{% else %}—{% endif %}</dd>
  <dt>Scans</dt><dd>{{ v.pages.length }}{% if v.pages.length < v.canvas_count %} of {{ v.canvas_count }} (sample){% endif %}</dd>
  <dt>Rights</dt><dd>{{ v.item.rights }}</dd>
</dl>

{% if v.articles.length %}
<p class="note">{{ v.articles.length }} index entries (machine-extracted){% if v.series.length %} in
  <span lang="zh">{{ v.series | join("、") }}{% if v.series.length == 5 %}等{% endif %}</span>{% endif %}. Each scan below lists its entries; use
  “Viewer” to open the page in DPUL. Search finds individual titles and authors across all volumes.</p>
{% endif %}

<h2>Pages</h2>
{% set title = v.label %}
{% for p in v.pages %}
  {% include "page-section.njk" %}
{% endfor %}

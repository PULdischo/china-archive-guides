# Pipeline caches (re-creatable; images are never published)
data/raw/
data/images/
data/ocr/
data/state/
# Site build
site/node_modules/
site/_site/
# Python
.venv/
__pycache__/
*.pyc

# Secrets
.env

# Full-scale exports are too large for git (guides.json ~86 MB, dataset ~72 MB).
# The dataset is published to Hugging Face; the site build will fetch it from there.
data/export/dataset/
data/export/site/guides.json

# Search records are large (34 MB); rebuilt by `cah search`. The eval set stays tracked.
data/export/search/records.jsonl
data/export/search/eval-*.json

# Prompt-test outputs (regenerable with `cah wenshi-test`)
data/export/wenshi-test/
data/export/site/guides.jsonl

# Built dataset release (published to Hugging Face; rebuilt by `cah release`)
data/release/
